APP_NAME=ConectaSUS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Belem

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Banco de dados (execução local, sem Docker)
# Ao rodar via Docker, DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD são
# sobrescritos automaticamente pelo compose.yaml (DB_HOST=db).
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=conectasus
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------
# Docker (docker compose)
# Credenciais usadas para criar o MySQL do container "db" e configurar o
# container "app". Altere antes do primeiro "docker compose up".
# ------------------------------------------------------------------
APP_PORT=8080
MYSQL_DATABASE=conectasus
MYSQL_USER=conectasus
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
